# Google Cloud Platform
GCP_PROJECT_ID=your-gcp-project-id                   
GOOGLE_APPLICATION_CREDENTIALS=path-to-your-service-account-key-in-json-file

# Cloud SQL (PostgreSQL)
POSTGRES_HOST=your-cloud-sql-public-ip
POSTGRES_PORT=5432
POSTGRES_DB=ecommerce
POSTGRES_USER=etl_user
POSTGRES_PASSWORD=your-postgres-password

# Cloud Storage Buckets
GCS_REGION=us-east1
GCS_RAW_BUCKET=your-raw-gcs-bucket
GCS_STAGING_BUCKET=your-staging-gcs-bucket
GCS_PROCESSED_BUCKET=your-processed-gcs-bucket